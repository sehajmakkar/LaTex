# Database (Neon or local Postgres)
# For Neon: use the connection string from Neon dashboard (Connection string)
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Auth (Clerk) - Google sign-in only; configure Google in Clerk Dashboard
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# AI (Gemini) — key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MODEL_FAST=gemini-3.1-flash-lite

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# LaTeX compilation (production: Railway or other host). When unset, Next uses local TeX (e.g. MacTeX).
LATEX_SERVICE_URL=https://your-latex-service.up.railway.app
LATEX_API_SECRET=use-openssl-rand-hex-32-and-same-value-on-railway

# Dodo Payments (billing) - optional; leave unset to disable billing
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PRODUCT_ID_PRO=

# Cloudflare R2 (optional, for storing original uploaded resumes)
# If unset, ATS will still work, but the report page will only show the plain-text resume.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your-r2-bucket-name
